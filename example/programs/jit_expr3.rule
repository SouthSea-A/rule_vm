    mov c(cmd_val:0:100:0:0:3), c(cmd_val:1:2:0:0:3)
    jmp sel2
s1_3:
    mov c(cmd_type:0:100:0:0:0), c(cmd_type:1:3:0:0:0)
    mov c(cmd_val:0:100:0:0:3), c(cmd_val:1:3:0:0:3)
    jmp sel2

sel2:
    cmp flag, op2, 0
    jmp s2_0, eq, flag
    cmp flag, op2, 1
    jmp s2_1, eq, flag
    cmp flag, op2, 2
    jmp s2_2, eq, flag
    jmp s2_3
s2_0:
    mov c(cmd_type:0:101:0:0:0), c(cmd_type:1:4:0:0:0)
