defvar 0 {
    var a    0:0:0:0:8 = 7
    var b    0:1:0:0:8 = 2
    var c    0:2:0:0:8 = 3
    var d    0:3:0:0:8 = 4
    var t1   0:4:0:0:8
    var t2   0:5:0:0:8
    var r    0:6:0:0:8
    var op1  0:7:0:0:8 = 1
    var op2  0:8:0:0:8 = 2
    var op3  0:9:0:0:8 = 0
    var flag 0:10:0:0:1
}

defcmd 1 {
    add t1, a, b
    sub t1, a, b
    mul t1, a, b
    div t1, a, b
    add t2, t1, c
    sub t2, t1, c
    mul t2, t1, c
    div t2, t1, c
    add r, t2, d
    sub r, t2, d
    mul r, t2, d
    div r, t2, d
}

defcmd 0 {
    alloc cmd 0:100:0:0:3
    alloc cmd 0:101:0:0:3
    alloc cmd 0:102:0:0:3

    cmp flag, op1, 0
    jmp s1_0, eq, flag
    cmp flag, op1, 1
    jmp s1_1, eq, flag
    cmp flag, op1, 2
    jmp s1_2, eq, flag
    jmp s1_3
s1_0:
    mov c(cmd_type:0:100:0:0:0), c(cmd_type:1:0:0:0:0)
    mov c(cmd_val:0:100:0:0:3), c(cmd_val:1:0:0:0:3)
