s2_3:
    mov c(cmd_type:0:101:0:0:0), c(cmd_type:1:7:0:0:0)
    mov c(cmd_val:0:101:0:0:3), c(cmd_val:1:7:0:0:3)
    jmp sel3

sel3:
    cmp flag, op3, 0
    jmp s3_0, eq, flag
    cmp flag, op3, 1
    jmp s3_1, eq, flag
    cmp flag, op3, 2
    jmp s3_2, eq, flag
    jmp s3_3
s3_0:
    mov c(cmd_type:0:102:0:0:0), c(cmd_type:1:8:0:0:0)
    mov c(cmd_val:0:102:0:0:3), c(cmd_val:1:8:0:0:3)
    jmp exec
s3_1:
    mov c(cmd_type:0:102:0:0:0), c(cmd_type:1:9:0:0:0)
    mov c(cmd_val:0:102:0:0:3), c(cmd_val:1:9:0:0:3)
    jmp exec
s3_2:
    mov c(cmd_type:0:102:0:0:0), c(cmd_type:1:10:0:0:0)
    mov c(cmd_val:0:102:0:0:3), c(cmd_val:1:10:0:0:3)
    jmp exec
s3_3:
    mov c(cmd_type:0:102:0:0:0), c(cmd_type:1:11:0:0:0)
    mov c(cmd_val:0:102:0:0:3), c(cmd_val:1:11:0:0:3)
    jmp exec

exec:
    jmp c(cmd_tgt:0:100:0:0:0)
}
start defcmd 0
