; 自修改/JIT 示例：动态生成表达式 (a op1 b) op2 c
; 模板在 manager 1；运行时把选中的类型和操作数复制到 slot 100/101 后执行。
defvar 0 {
    var a    0:0:0:0:8 = 6
    var b    0:1:0:0:8 = 2
    var c    0:2:0:0:8 = 3
    var tmp  0:3:0:0:8
    var r    0:4:0:0:8
    var op1  0:5:0:0:8 = 0
    var op2  0:6:0:0:8 = 2
    var flag 0:7:0:0:1
}

defcmd 1 {
    add tmp, a, b
    sub tmp, a, b
    mul tmp, a, b
    div tmp, a, b
    add r, tmp, c
    sub r, tmp, c
    mul r, tmp, c
    div r, tmp, c
}

defcmd 0 {
    alloc cmd 0:100:0:0:3
    alloc cmd 0:101:0:0:3

    cmp flag, op1, 0
    jmp s1_add, eq, flag
    cmp flag, op1, 1
    jmp s1_sub, eq, flag
    cmp flag, op1, 2
    jmp s1_mul, eq, flag
    jmp s1_div

s1_add:
    mov c(cmd_type:0:100:0:0:0), c(cmd_type:1:0:0:0:0)
    mov c(cmd_val:0:100:0:0:3), c(cmd_val:1:0:0:0:3)
    jmp sel2
s1_sub:
    mov c(cmd_type:0:100:0:0:0), c(cmd_type:1:1:0:0:0)
    mov c(cmd_val:0:100:0:0:3), c(cmd_val:1:1:0:0:3)
    jmp sel2
s1_mul:
    mov c(cmd_type:0:100:0:0:0), c(cmd_type:1:2:0:0:0)
    mov c(cmd_val:0:100:0:0:3), c(cmd_val:1:2:0:0:3)
    jmp sel2
s1_div:
    mov c(cmd_type:0:100:0:0:0), c(cmd_type:1:3:0:0:0)
    mov c(cmd_val:0:100:0:0:3), c(cmd_val:1:3:0:0:3)
    jmp sel2

sel2:
    cmp flag, op2, 0
    jmp s2_add, eq, flag
    cmp flag, op2, 1
    jmp s2_sub, eq, flag
    cmp flag, op2, 2
    jmp s2_mul, eq, flag
    jmp s2_div

s2_add:
    mov c(cmd_type:0:101:0:0:0), c(cmd_type:1:4:0:0:0)
    mov c(cmd_val:0:101:0:0:3), c(cmd_val:1:4:0:0:3)
    jmp exec
s2_sub:
    mov c(cmd_type:0:101:0:0:0), c(cmd_type:1:5:0:0:0)
    mov c(cmd_val:0:101:0:0:3), c(cmd_val:1:5:0:0:3)
    jmp exec
s2_mul:
    mov c(cmd_type:0:101:0:0:0), c(cmd_type:1:6:0:0:0)
    mov c(cmd_val:0:101:0:0:3), c(cmd_val:1:6:0:0:3)
    jmp exec
s2_div:
    mov c(cmd_type:0:101:0:0:0), c(cmd_type:1:7:0:0:0)
    mov c(cmd_val:0:101:0:0:3), c(cmd_val:1:7:0:0:3)
    jmp exec

exec:
    jmp c(cmd_tgt:0:100:0:0:0)
}

start defcmd 0
